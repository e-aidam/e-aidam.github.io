  "thoughtProcess": [
    {
      "title": "Start from raw counts",
      "body": "Use STAR-derived gene counts as the common substrate for filtering, identifier mapping, and differential expression."
    },
    {
      "title": "Rank genes by treatment contrast",
      "body": "Use DESeq2 log2 fold change for WBH versus sham to create the ordered list consumed by the custom GSEA statistic."
    },
    {
      "title": "Implement GSEA manually",
      "body": "Walk down the ranked list, increasing the running score on gene-set hits and penalizing misses to find the maximum enrichment deviation."
    },
    {
      "title": "Stress-test significance",
      "body": "Use phenotype-label permutations to estimate NES and p-values, then compare trends to Broad GSEA results."
    }
  ],
